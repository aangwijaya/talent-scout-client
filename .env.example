# Talent Scout client (SvelteKit BFF) — copy to .env and fill in.
# All vars are private server-side ($env/dynamic/private). No PUBLIC_*.
# Never commit .env. See docs/TECH-STACK.md §5 and docs/SERVER-SIDE.md.

# Go API base (also used as SSE base URL returned to the browser)
API_BASE_URL=http://localhost:8080

# true = mock layer (no network); false = real Go API
USE_MOCK=true

# Must match the server BFF_SHARED_SECRET. Generate: openssl rand -base64 32
BFF_SHARED_SECRET=
